# Copy to .env and fill in. Never commit .env.
# test = RevenueCat Test Store (dev builds, demo video). galaxy = Samsung Galaxy Store build.
EXPO_PUBLIC_RC_STORE=test
# RevenueCat public SDK key for the Test Store app (starts with test_). Dev builds only.
EXPO_PUBLIC_RC_TEST_KEY=
# RevenueCat public SDK key for the Galaxy app. Set it in EAS env for the production profile.
EXPO_PUBLIC_RC_GALAXY_KEY=
# User-Agent sent to MET Norway and other fair-use APIs.
EXPO_PUBLIC_APP_UA=Temen/1.0 github.com/omshukla24/temen
