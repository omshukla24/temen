# Copy to .env and fill in. Never commit .env. Every value here is public by design
# (it ships inside the app); secrets never go in EXPO_PUBLIC_ variables.

# test = RevenueCat Test Store (dev builds, demo APK). galaxy = Samsung Galaxy Store build.
EXPO_PUBLIC_RC_STORE=test
# RevenueCat public SDK key for the Test Store app (starts with test_). Never in a store build.
EXPO_PUBLIC_RC_TEST_KEY=
# RevenueCat public SDK key for the Galaxy app. Set it in EAS env for the production profile.
EXPO_PUBLIC_RC_GALAXY_KEY=

# Optional accounts (Supabase project URL + publishable key). Leave empty to ship without accounts.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where Help → Contact us and the privacy policy send people. Empty = the GitHub issue tracker.
EXPO_PUBLIC_SUPPORT_EMAIL=

# User-Agent sent to MET Norway and other fair-use APIs.
EXPO_PUBLIC_APP_UA=Temen/1.0 github.com/omshukla24/temen
